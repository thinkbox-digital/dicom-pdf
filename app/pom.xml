<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>digital.thinkbox</groupId>
    <artifactId>pdf-tools-parent</artifactId>
    <version>1.0.0</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>dicom-pdf</artifactId>
  <version>0.62.0</version>
  <name>DICOM PDF pilot</name>
  <properties>
    <dcm4che.version>5.33.1</dcm4che.version>
    <opencv.version>4.9.0-dcm</opencv.version>
    <javafx.version>23.0.2</javafx.version>
    <exec.skip>false</exec.skip>
  </properties>
  <repositories>
    <repository>
      <id>weasis-codecs</id>
      <url>https://raw.githubusercontent.com/nroduit/mvn-repo/a08885785964549f1147da917a7ca2ae6241e53e/</url>
      <releases><checksumPolicy>fail</checksumPolicy></releases>
      <snapshots><enabled>false</enabled></snapshots>
    </repository>
    <repository>
      <id>dcm4che</id>
      <url>https://www.dcm4che.org/maven2/</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>com.github.hypfvieh</groupId>
      <artifactId>dbus-java-transport-native-unixsocket</artifactId>
      <version>5.2.2</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>digital.thinkbox</groupId>
      <artifactId>pdf-security</artifactId>
      <version>${pdf-security.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>digital.thinkbox</groupId>
      <artifactId>pdf-security</artifactId>
      <version>${pdf-security.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>xmpbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <dependency>
      <groupId>org.dcm4che</groupId>
      <artifactId>dcm4che-core</artifactId>
      <version>${dcm4che.version}</version>
    </dependency>
    <dependency>
      <groupId>org.dcm4che</groupId>
      <artifactId>dcm4che-imageio</artifactId>
      <version>${dcm4che.version}</version>
    </dependency>
    <dependency>
      <groupId>org.dcm4che</groupId>
      <artifactId>dcm4che-imageio-rle</artifactId>
      <version>${dcm4che.version}</version>
    </dependency>
    <dependency>
      <groupId>com.twelvemonkeys.imageio</groupId>
      <artifactId>imageio-jpeg</artifactId>
      <version>3.12.0</version>
    </dependency>
    <dependency>
      <groupId>org.weasis.core</groupId>
      <artifactId>weasis-core-img</artifactId>
      <version>4.9.0.1</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.17</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.17</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.15.0</version>
    </dependency>
    <dependency>
      <groupId>io.github.erdtman</groupId>
      <artifactId>java-json-canonicalization</artifactId>
      <version>1.1</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/../src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/../viewer/certificates</directory>
        <targetPath>certificates</targetPath>
        <includes><include>digicert-g4-timestamp.der</include></includes>
      </resource>
      <resource>
        <directory>${project.basedir}/../viewer/extension/icons</directory>
        <targetPath>icons</targetPath>
        <includes>
          <include>icon-*.png</include>
        </includes>
      </resource>
      <resource>
        <directory>${project.basedir}/..</directory>
        <targetPath>META-INF/dicom-pdf</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
          <include>THIRD_PARTY_NOTICES.md</include>
          <include>third_party_licenses/**</include>
          <include>src/main/java/eu/europa/esig/dss/pades/PAdESUtils.java</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.3.1</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.9.0</version>
        <executions>
          <execution>
            <id>bundle-viewer-platforms</id>
            <phase>prepare-package</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/META-INF/dicom-pdf/javafx</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>org.openjfx</groupId>
                  <artifactId>javafx-graphics</artifactId>
                  <version>${javafx.version}</version>
                  <classifier>linux</classifier>
                  <destFileName>linux.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.openjfx</groupId>
                  <artifactId>javafx-graphics</artifactId>
                  <version>${javafx.version}</version>
                  <classifier>linux-aarch64</classifier>
                  <destFileName>linux-aarch64.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.openjfx</groupId>
                  <artifactId>javafx-graphics</artifactId>
                  <version>${javafx.version}</version>
                  <classifier>mac</classifier>
                  <destFileName>mac.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.openjfx</groupId>
                  <artifactId>javafx-graphics</artifactId>
                  <version>${javafx.version}</version>
                  <classifier>mac-aarch64</classifier>
                  <destFileName>mac-aarch64.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.openjfx</groupId>
                  <artifactId>javafx-graphics</artifactId>
                  <version>${javafx.version}</version>
                  <classifier>win</classifier>
                  <destFileName>win.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>bundle-dicom-decoders</id>
            <phase>process-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/dicom-codecs</outputDirectory>
              <artifactItems>
                <artifactItem>
                  <groupId>org.weasis.thirdparty.org.opencv</groupId>
                  <artifactId>libopencv_java</artifactId>
                  <version>${opencv.version}</version>
                  <type>so</type>
                  <classifier>linux-x86-64</classifier>
                  <destFileName>linux-x86-64.so</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.weasis.thirdparty.org.opencv</groupId>
                  <artifactId>libopencv_java</artifactId>
                  <version>${opencv.version}</version>
                  <type>so</type>
                  <classifier>linux-aarch64</classifier>
                  <destFileName>linux-aarch64.so</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.weasis.thirdparty.org.opencv</groupId>
                  <artifactId>libopencv_java</artifactId>
                  <version>${opencv.version}</version>
                  <type>dylib</type>
                  <classifier>macosx-x86-64</classifier>
                  <destFileName>macosx-x86-64.dylib</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.weasis.thirdparty.org.opencv</groupId>
                  <artifactId>libopencv_java</artifactId>
                  <version>${opencv.version}</version>
                  <type>dylib</type>
                  <classifier>macosx-aarch64</classifier>
                  <destFileName>macosx-aarch64.dylib</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.weasis.thirdparty.org.opencv</groupId>
                  <artifactId>opencv_java</artifactId>
                  <version>${opencv.version}</version>
                  <type>dll</type>
                  <classifier>windows-x86-64</classifier>
                  <destFileName>windows-x86-64.dll</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
          <execution>
            <id>retain-eu-dss-sources</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <classifier>sources</classifier>
              <includeGroupIds>eu.europa.ec.joinup.sd-dss</includeGroupIds>
              <includeScope>runtime</includeScope>
              <outputDirectory>${project.build.outputDirectory}/META-INF/dicom-pdf/eu-dss-sources</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <configuration>
          <useModulePath>false</useModulePath>
          <argLine>-Djava.awt.headless=true</argLine>
          <workingDirectory>${project.basedir}/..</workingDirectory>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <forceCreation>true</forceCreation>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <id>desktop</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <artifactSet>
                <excludes>
                  <exclude>org.openjfx:*</exclude>
                  <exclude>com.github.hypfvieh:*</exclude>
                </excludes>
              </artifactSet>
              <outputFile>${project.build.directory}/distribution/dicom-pdf-${project.version}-desktop.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>eu.europa.ec.joinup.sd-dss:dss-pades</artifact>
                  <excludes><exclude>eu/europa/esig/dss/pades/PAdESUtils.class</exclude></excludes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopViewer*.class</exclude>
                    <exclude>META-INF/dicom-pdf/javafx/**</exclude>
                    <exclude>desktop-viewer.css</exclude>

                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.md</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.md</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/DEPENDENCIES</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>digital.thinkbox.dicompdf.ArchiveDesktop</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
          <execution>
            <id>viewer</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <artifactSet>
                <excludes>
                  <exclude>org.openjfx:javafx-graphics</exclude>


                </excludes>
              </artifactSet>
              <outputFile>${project.build.directory}/distribution/dicom-pdf-${project.version}-viewer.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>eu.europa.ec.joinup.sd-dss:dss-pades</artifact>
                  <excludes><exclude>eu/europa/esig/dss/pades/PAdESUtils.class</exclude></excludes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>digital.thinkbox:dicom-pdf</artifact>
                  <excludes>
                    <exclude>digital/thinkbox/dicompdf/ArchiveDesktop*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/Main*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopActivity*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopProcess*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopRequest*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopInputs*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopReplacement*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopPassword*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopSigningMain*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopSigningSelection*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopFileDialogs*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/JarPublication*.class</exclude>
                    <exclude>viewer.html</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.md</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.md</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/DEPENDENCIES</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>digital.thinkbox.dicompdf.DesktopViewerLauncher</mainClass>
                  <manifestEntries><Multi-Release>true</Multi-Release></manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
          <execution>
            <id>command-line</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <artifactSet>
                <excludes>
                  <exclude>org.openjfx:*</exclude>
                  <exclude>com.github.hypfvieh:*</exclude>
                </excludes>
              </artifactSet>
              <outputFile>${project.build.directory}/distribution/dicom-pdf-${project.version}.jar</outputFile>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>eu.europa.ec.joinup.sd-dss:dss-pades</artifact>
                  <excludes><exclude>eu/europa/esig/dss/pades/PAdESUtils.class</exclude></excludes>
                </filter>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/**/module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>digital.thinkbox:dicom-pdf</artifact>
                  <excludes>
                    <exclude>digital/thinkbox/dicompdf/ArchiveDesktop*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopViewer*.class</exclude>
                    <exclude>META-INF/dicom-pdf/javafx/**</exclude>
                    <exclude>desktop-viewer.css</exclude>

                    <exclude>digital/thinkbox/dicompdf/DesktopActivity*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopProcess*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopRequest*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopInputs*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopReplacement*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopPassword*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopSigningMain*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopSigningSelection*.class</exclude>
                    <exclude>digital/thinkbox/dicompdf/DesktopFileDialogs*.class</exclude>
                    <exclude>icons/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.md</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.md</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/DEPENDENCIES</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>digital.thinkbox.dicompdf.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>publish-runnable-jars</id>
            <phase>verify</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target xmlns:if="ant:if" xmlns:unless="ant:unless">
                <property name="screenshot.archive" location="${project.basedir}/../out/greg.pdf" />
                <property name="screenshot.ca" value="" />
                <available file="${screenshot.archive}" type="file" property="screenshot.archive.available" />
                <echo unless:set="screenshot.archive.available">Skipping README screenshot refresh because out/greg.pdf is missing.</echo>
                <java classname="digital.thinkbox.dicompdf.DesktopViewerScreenshot"
                      fork="true" failonerror="true" timeout="180000" if:set="screenshot.archive.available">
                  <classpath refid="maven.test.classpath" />
                  <arg file="${screenshot.archive}" />
                  <arg file="${project.build.directory}/desktop-viewer.png" />
                  <arg file="${project.build.directory}/desktop-security-report.png" />
                  <arg value="${screenshot.ca}" />
                </java>
                <java classname="digital.thinkbox.dicompdf.JarPublication" fork="true" failonerror="true">
                  <classpath>
                    <pathelement location="${project.build.outputDirectory}" />
                  </classpath>
                  <arg value="${project.build.directory}/distribution" />
                  <arg value="${project.basedir}/../dist" />
                  <arg value="${project.version}" />
                </java>
                <copy file="${project.build.directory}/desktop-viewer.png"
                      tofile="${project.basedir}/../docs/desktop-viewer.png" overwrite="true" if:set="screenshot.archive.available" />
                <copy file="${project.build.directory}/desktop-security-report.png"
                      tofile="${project.basedir}/../docs/desktop-security-report.png" overwrite="true" if:set="screenshot.archive.available" />
                <replaceregexp file="${project.basedir}/../README.md" encoding="UTF-8"
                               match="in desktop viewer `[0-9]+\.[0-9]+\.[0-9]+`"
                               replace="in desktop viewer `${project.version}`" flags="g" if:set="screenshot.archive.available" />
                <replaceregexp file="${project.basedir}/../docs/index.md" encoding="UTF-8"
                               match="desktop-viewer\.png\?v=[0-9]+\.[0-9]+\.[0-9]+"
                               replace="desktop-viewer.png?v=${project.version}" flags="g" if:set="screenshot.archive.available" />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <directory>${project.basedir}/../target/app</directory>
    <sourceDirectory>${project.basedir}/../src/main/java</sourceDirectory>
    <testSourceDirectory>${project.basedir}/../src/test/java</testSourceDirectory>
  </build>
</project>
